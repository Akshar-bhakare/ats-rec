  logTest('PUT /:id error handling: not found -> 404', [
    'Mock: InterviewScheduleService.update() returns null',
    'Expected: 404 + { error:"Not found" }',
  ]);

  // Patch service method for this test only (route instantiates the service internally)
  const { default: InterviewScheduleService } = await import(
    '../../services/VirtualInterview/interviewScheduleService.js'
  );

  const originalUpdate = InterviewScheduleService.prototype.update;

  try {
    InterviewScheduleService.prototype.update = async () => null;

    const server = buildServer({ models: { InterviewSchedule: {} } });
    await server.ready();

    const scheduleId = new mongoose.Types.ObjectId().toString();

    const res = await server.inject({
      method: 'PUT',
      url: `/api/interviewschedules/${scheduleId}`,
      payload: { any: 'payload' },
    });

    assert.equal(res.statusCode, 404);
    const body = res.json();
    assert.equal(body.error, 'Not found');

    await server.close();
  } finally {
    // Always restore
    InterviewScheduleService.prototype.update = originalUpdate;
  }
});
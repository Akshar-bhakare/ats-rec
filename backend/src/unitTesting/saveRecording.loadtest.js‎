    sleepBetweenBatchesMs,
    logResourcesEachBatch,
    logResourcesIntervalMs,
  });

  logResources("startup");

  // Optional interval resource logging
  let intervalHandle = null;
  if (Number.isFinite(logResourcesIntervalMs) && logResourcesIntervalMs > 0) {
    intervalHandle = setInterval(() => logResources(`interval ${logResourcesIntervalMs}ms`), logResourcesIntervalMs);
  }

  const files = readFilesFromDir(dir);
  console.log(`Using ${files.length} file(s) from: ${path.resolve(dir)}`);

  let singleRecordingData = null;

  if (useSingleFile) {
    const chosen = files[0];
    console.log(`Using SINGLE FILE for all uploads: ${path.basename(chosen)}`);
    singleRecordingData = toDataUriBase64(chosen);
    console.log(`Base64 payload size (chars): ${singleRecordingData.length}`);
    logResources("after base64 build");
  }

  const fileChooser = !useSingleFile
    ? (globalIndex) => {
        const f = files[globalIndex % files.length];
        return toDataUriBase64(f); // build per request (more CPU)
      }
    : null;

  // ✅ WARMUP (not counted)
  if (Number.isFinite(warmup) && warmup > 0) {
    console.log(`\n=== Warmup (${warmup} request(s), not counted in stats) ===`);
    const warmTasks = [];
    for (let i = 0; i < warmup; i++) {
      const data = fileChooser ? fileChooser(i) : singleRecordingData;
      warmTasks.push(postSaveRecording({ recordingData: data, index: -1000 - i }));
    }
    const warmRes = await Promise.all(warmTasks);
    const warmOk = warmRes.filter((r) => r.ok).length;
    const warmFail = warmRes.filter((r) => !r.ok);
    console.log(`Warmup OK=${warmOk}, FAIL=${warmFail.length}`);
    if (warmFail.length) {
      console.log("Warmup failures (first 3):");
      warmFail.slice(0, 3).forEach((f) => console.log(` - status=${f.status} err=${String(f.error).slice(0, 200)}`));
    }
  }

  const allResults = [];
  let batchNo = 1;

  for (let sent = 0; sent < totalUploads; sent += effectiveConcurrency) {
    const batchSize = Math.min(effectiveConcurrency, totalUploads - sent);

    const results = await runBatch(
      { batchSize, recordingData: singleRecordingData, fileChooser },
      batchNo++,
      sent
    );

    allResults.push(...results);

    if (sleepBetweenBatchesMs > 0) {
      await sleep(sleepBetweenBatchesMs);
    }
  }

  const ok = allResults.filter((r) => r.ok);
  const fail = allResults.filter((r) => !r.ok);
  const times = ok.map((r) => r.ms);

  console.log("\n=== Overall Summary ===");
  console.log(`Total=${allResults.length}, OK=${ok.length}, FAIL=${fail.length}`);

  if (!ok.length) {
    console.log("❌ No successful requests to compute latency stats.");
    if (intervalHandle) clearInterval(intervalHandle);
    logResources("end");
    process.exitCode = 2;
    return;
  }

  const avg = mean(times);
  const min = Math.min(...times);
  const max = Math.max(...times);
  const p50 = percentile(times, 50);
  const p95 = percentile(times, 95);

  console.log(
    `Latency ms: min=${min.toFixed(0)} avg=${avg.toFixed(0)} p50=${p50.toFixed(0)} p95=${p95.toFixed(
      0
    )} max=${max.toFixed(0)}`
  );

  // ✅ More stable tolerance for tiny samples (p95 is noisy when total is small)
  const effectiveTolerancePctFinal = totalUploads < 20 ? Math.max(tolerancePct, 50) : tolerancePct;

  // ✅ variance check using p95 (more stable than max), with adjusted tolerance for small totals
  const allowedP95 = avg * (1 + effectiveTolerancePctFinal / 100);
  const passVariance = p95 <= allowedP95;

  console.log(
    `Variance check (p95): tolerance=${effectiveTolerancePctFinal}% -> allowedP95=${allowedP95.toFixed(
      0
    )}ms, observedP95=${p95.toFixed(0)}ms`
  );
  console.log(passVariance ? "✅ PASS variance tolerance" : "❌ FAIL variance tolerance");

  if (intervalHandle) clearInterval(intervalHandle);
  logResources("end");

  if (fail.length || !passVariance) process.exitCode = 2;
};

main().catch((e) => {
  console.error("Fatal:", e);
  process.exit(1);
});
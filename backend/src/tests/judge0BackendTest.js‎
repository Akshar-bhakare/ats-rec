/**
 * Judge0 CE Backend Test
 * 
 * Tests the complete Judge0 CE integration:
 * 1. Verifies Judge0 CE is running
 * 2. Tests execution for all supported languages using actual driver templates
 * 3. Tests error handling (compilation errors, runtime errors)
 * 4. Verifies JSON harness output parsing
 * 
 * Prerequisites:
 * - Judge0 CE running on JUDGE0_URL (default: http://localhost:2358)
 * - Environment variables configured in .env
 */

import axios from 'axios';
import dotenv from 'dotenv';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';
import { buildSourceWithHarness, buildStdinPayload } from '../utils/driverTemplates.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

dotenv.config({ path: join(__dirname, '../../.env') });

// Configuration
const JUDGE0_URL = process.env.JUDGE0_URL || 'http://localhost:2358';
const JUDGE0_TIMEOUT = parseInt(process.env.JUDGE0_WAIT_TIMEOUT || '10', 10);

// Test counters
let totalTests = 0;
let passedTests = 0;
let failedTests = 0;

// Color output helpers
const colors = {
    reset: '\x1b[0m',
    green: '\x1b[32m',
    red: '\x1b[31m',
    yellow: '\x1b[33m',
    blue: '\x1b[34m',
    cyan: '\x1b[36m'
};

function log(message, color = 'reset') {
    console.log(`${colors[color]}${message}${colors.reset}`);
}

function logTest(name, passed, details = '') {
    totalTests++;
    if (passed) {
        passedTests++;
        log(`✅ ${name}`, 'green');
    } else {
        failedTests++;
        log(`❌ ${name}`, 'red');
        if (details) log(`   ${details}`, 'yellow');
    }
}

/**
 * Test 1: Verify Judge0 CE is running
 */
async function testJudge0Connection() {
    log('\n=== Test 1: Judge0 CE Connection ===', 'cyan');
    try {
        const response = await axios.get(`${JUDGE0_URL}/about`, { timeout: 5000 });
        logTest('Judge0 CE is reachable', true);
        log(`   Version: ${response.data.version || 'Unknown'}`, 'blue');
        return true;
    } catch (error) {
        logTest('Judge0 CE is reachable', false, `Cannot connect to ${JUDGE0_URL}. Is Judge0 CE running?`);
        return false;
    }
}


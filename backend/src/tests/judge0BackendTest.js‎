/**
 * Execute a test for a specific language
 */
async function runLanguageTest(testConfig) {
    try {
        log(`   Testing ${testConfig.name}...`, 'reset');
        
        // 1. Build Source with Harness
        const fullSource = buildSourceWithHarness({
            language: { judge0Id: testConfig.judge0Id },
            userSource: testConfig.userSource,
            signature: testConfig.signature
        });

        // 2. Build Stdin Payload
        const stdin = buildStdinPayload({
            signature: testConfig.signature,
            testCase: { args: testConfig.args }
        });

        // 3. Submit to Judge0
        const response = await axios.post(
            `${JUDGE0_URL}/submissions?base64_encoded=false&wait=true`,
            {
                language_id: testConfig.judge0Id,
                source_code: fullSource,
                stdin: stdin,
                cpu_time_limit: 5,
                memory_limit: 128000
            },
            { timeout: JUDGE0_TIMEOUT * 1000 }
        );

        const result = response.data;
                
        console.log("\n[ DEBUG] status =", result.status);
        console.log("[ DEBUG] compile_output =", result.compile_output?.slice(0, 400));
        console.log("[DEBUG] stderr =", result.stderr?.slice(0, 400));
        console.log("[ DEBUG] stdout =", result.stdout?.slice(0, 400));
        console.log("[ DEBUG] message =", result.message);
        console.log("[ DEBUG] full =", JSON.stringify(result, null, 2));
        

        
        // 4. Verify Verdict
        if (result.status?.id !== 3) {
            logTest(`${testConfig.name} execution`, false, `Status: ${result.status?.description}`);
            if (result.compile_output) log(`      Compile Error: ${result.compile_output.substring(0, 100)}...`, 'red');
            if (result.stderr) log(`      Stderr: ${result.stderr.substring(0, 100)}...`, 'red');
            return false;
        }

        // 5. Verify Output
        if (!result.stdout) {
            logTest(`${testConfig.name} has stdout`, false, 'No stdout returned');
            return false;
        }

        try {
            const output = JSON.parse(result.stdout.trim());
            
            if (output.error) {
                logTest(`${testConfig.name} harness error`, false, `Harness reported error: ${output.error}`);
                return false;
            }

            const actualResult = output.results[0];
            
            let isCorrect = false;
            if (testConfig.customCheck) {
                isCorrect = testConfig.customCheck(actualResult, testConfig.expected);
            } else {
                isCorrect = JSON.stringify(actualResult) === JSON.stringify(testConfig.expected);
            }

            logTest(`${testConfig.name} result correct`, isCorrect, `Expected: ${testConfig.expected}, Got: ${actualResult}`);
            return isCorrect;

        } catch (e) {
            logTest(`${testConfig.name} valid JSON`, false, `Parse error: ${e.message}\nOutput: ${result.stdout}`);
            return false;
        }

    } catch (error) {
        logTest(`${testConfig.name} execution error`, false, error.message);
        return false;
    }
}

/**
 * Test Error Handling (Compilation & Runtime)
 * We'll use Python for these checks as it's reliable
 */
async function testErrorHandling() {
    log('\n=== Error Handling Tests ===', 'cyan');

    // Compilation Error
    const compErrorSource = `class Solution:\n    def add(self, a, b):\n        retur a + b  # Syntax error`;
    try {
        const response = await axios.post(
            `${JUDGE0_URL}/submissions?base64_encoded=false&wait=true`,
            {
                language_id: 71,
                source_code: compErrorSource,
                stdin: "",
                cpu_time_limit: 2
            },
            { timeout: JUDGE0_TIMEOUT * 1000 }
        );
        const result = response.data;
        logTest('Compilation error detection', result.status?.id === 6, `Got status: ${result.status?.description}`);
    } catch (e) {
        logTest('Compilation error test', false, e.message);
    }

    // Runtime Error (Zero Division)
    const runtimeErrorSource = `class Solution:\n    def divide(self, a, b):\n        return a // b`;
    const runtimeConfig = {
        name: 'Runtime Error',
        judge0Id: 71, // Python
        signature: { functionName: 'divide', params: [{name:'a'}, {name:'b'}], className: 'Solution' },
        userSource: runtimeErrorSource,
        args: [10, 0], // Div by zero
        expected: null
    };

    // We expect the HARNESS to catch this and print a JSON error, OR Judge0 to report Runtime Error (11)
    // Our harness catches exceptions, so we expect status 3 (Accepted) but output containing "error"
    try {
        const fullSource = buildSourceWithHarness({
            language: { judge0Id: 71 },
            userSource: runtimeErrorSource,
            signature: runtimeConfig.signature
        });
        const stdin = buildStdinPayload({ signature: runtimeConfig.signature, testCase: { args: runtimeConfig.args } });

        const response = await axios.post(
            `${JUDGE0_URL}/submissions?base64_encoded=false&wait=true`,
            {
                language_id: 71,
                source_code: fullSource,
                stdin: stdin,
                cpu_time_limit: 2
            },
            { timeout: JUDGE0_TIMEOUT * 1000 }
        );
        const result = response.data;
        
        if (result.stdout) {
            const output = JSON.parse(result.stdout.trim());
            logTest('Harness caught runtime error', !!output.error, `Error: ${output.error}`);
        } else {
             // Fallback check if Judge0 caught it directly
             logTest('Runtime error status', result.status?.id !== 3, `Status: ${result.status?.description}`);
        }

    } catch (e) {
        logTest('Runtime error test', false, e.message);
    }
}

/**
 * Main test runner
 */
async function runAllTests() {
    log('\n╔════════════════════════════════════════════╗', 'cyan');
    log('║   Judge0 CE Backend Integration Tests   ║', 'cyan');
    log('╚════════════════════════════════════════════╝', 'cyan');
    
    log(`\nConfiguration:`, 'blue');
    log(`  Judge0 URL: ${JUDGE0_URL}`, 'blue');
    
    const connectionOk = await testJudge0Connection();
    if (!connectionOk) {
        log('\n❌ Cannot proceed without Judge0 CE connection', 'red');
        process.exit(1);
    }

    log('\n=== Language Support Tests ===', 'cyan');
    
    // Run Standard Languages
    for (const test of languageTests) {
        await runLanguageTest(test);
    }

    // Run Phase 3 Languages (Optional - log but don't fail entire suite if configured to skip)
    log('\n=== Phase 3 / Experimental Languages ===', 'cyan');
    for (const test of phase3Tests) {
        await runLanguageTest(test);
    }

    // Run Error Handling
    await testErrorHandling();
    
    // Summary
    log('\n╔════════════════════════════════════════════╗', 'cyan');
    log('║              Test Summary                ║', 'cyan');
    log('╚════════════════════════════════════════════╝', 'cyan');
    log(`\nTotal Tests: ${totalTests}`, 'blue');
    log(`Passed: ${passedTests}`, 'green');
    log(`Failed: ${failedTests}`, failedTests > 0 ? 'red' : 'green');
    
    process.exit(failedTests === 0 ? 0 : 1);
}

runAllTests().catch(error => {
    console.error('Fatal Error:', error);
    process.exit(1);
});

/**
 * AI Virtual Interview POC (Dev/Local).
 * Flow: load .env → login → resolve/create interview schedule → load candidate & job → (optional) generate script →
 * simulate interview via text Q/A (/api/ai/respond) → end interview → (optional) evaluate & fetch transcript.
 * Saves result artifacts to ./output (ok/fail). Text-based simulation only (no WebRTC).
 */

import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

function loadLocalEnv(envPath) {
  if (!fs.existsSync(envPath)) return;
  const raw = fs.readFileSync(envPath, "utf8");
  const lines = raw.split(/\r?\n/);
  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) continue;
    const eqIdx = trimmed.indexOf("=");
    if (eqIdx <= 0) continue;
    const key = trimmed.slice(0, eqIdx).trim();
    let value = trimmed.slice(eqIdx + 1).trim();
    if (
      (value.startsWith('"') && value.endsWith('"')) ||
      (value.startsWith("'") && value.endsWith("'"))
    ) {
      value = value.slice(1, -1);
    }
    if (!(key in process.env)) process.env[key] = value;
  }
}

function logSection(title) {
  console.log(`\n========== ${title} ==========\n`);
}

function boolFromEnv(name, defaultValue) {
  const raw = (process.env[name] ?? "").toString().trim().toLowerCase();
  if (!raw) return defaultValue;
  return ["1", "true", "yes", "y", "on"].includes(raw);
}

function numFromEnv(name, defaultValue) {
  const raw = (process.env[name] ?? "").toString().trim();
  const n = Number(raw);
  return Number.isFinite(n) ? n : defaultValue;
}

async function safeJson(res) {
  const text = await res.text();
  try {
    return JSON.parse(text);
  } catch {
    return { raw: text };
  }
}

async function requestJson(url, options = {}, timeoutMs = 30_000) {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), timeoutMs);
  try {
    const res = await fetch(url, { ...options, signal: controller.signal });
    const body = await safeJson(res);
    return { ok: res.ok, status: res.status, body, headers: res.headers };
  } finally {
    clearTimeout(timeout);
  }
}

function writeArtifact(name, payload) {
  const outDir = path.join(__dirname, "output");
  if (!fs.existsSync(outDir)) fs.mkdirSync(outDir, { recursive: true });
  const outFile = path.join(outDir, name);
  fs.writeFileSync(outFile, JSON.stringify(payload, null, 2));
  return outFile;
}

function sleep(ms) {
  return new Promise((r) => setTimeout(r, ms));
}

function formatDateLocal(d) {
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");
  return `${yyyy}-${mm}-${dd}`;
}

function formatTimeLocal(d) {
  const hh = String(d.getHours()).padStart(2, "0");
  const mm = String(d.getMinutes()).padStart(2, "0");
  return `${hh}:${mm}`;
}

function pickLatestSchedule(list) {
  if (!Array.isArray(list) || list.length === 0) return null;
  const byDate = [...list].sort((a, b) => {
    const aTime = new Date(a?.startAt || a?.createdAt || 0).getTime();
    const bTime = new Date(b?.startAt || b?.createdAt || 0).getTime();
    return bTime - aTime;
  });
  return byDate[0] || null;
}

function parseAnswersFromEnv() {
  const filePath = (process.env.POC_ANSWERS_FILE || "").trim();
  if (filePath) {
    try {
      const raw = fs.readFileSync(filePath, "utf8");
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) return parsed.map((s) => String(s).trim()).filter(Boolean);
    } catch (err) {
      console.warn("[POC] Failed to read POC_ANSWERS_FILE:", err?.message || err);
    }
  }

  const raw = (process.env.POC_ANSWERS || "").trim();
  if (!raw) return [];

  return raw
    .split(/\s*\|\s*/)
    .map((s) => s.trim())
    .filter(Boolean);
}

async function main() {
  loadLocalEnv(path.join(__dirname, ".env"));

  const baseUrl = (process.env.POC_BASE_URL || "http://localhost:8080").replace(/\/+$/, "");
  const email = process.env.POC_EMAIL;
  const password = process.env.POC_PASSWORD;

  let candidateId = (process.env.POC_CANDIDATE_ID || "").trim();
  let jobId = (process.env.POC_JOB_ID || "").trim();
  const candidateAtsId = (process.env.POC_CANDIDATE_ATS_ID || "").trim();

  const createSchedule = boolFromEnv("POC_CREATE_SCHEDULE", false);
  const requireAiSchedule = boolFromEnv("POC_REQUIRE_AI", true);

  const scheduleIdEnv = (process.env.POC_INTERVIEW_SCHEDULE_ID || "").trim();

  const interviewMode = (process.env.POC_INTERVIEW_MODE || "Virtual").trim();
  const interviewerType = (process.env.POC_INTERVIEWER_TYPE || "AI").trim();
  const interviewType = (process.env.POC_INTERVIEW_TYPE || "Technical").trim();
  const difficultyLevel = (process.env.POC_DIFFICULTY_LEVEL || "Intermediate").trim();
  const roundType = (process.env.POC_ROUND_TYPE || "Speaking").trim();
  const notes = (process.env.POC_NOTES || "POC virtual interview").trim();

  const durationMinutes = numFromEnv("POC_DURATION_MINUTES", 30);
  const startDate = (process.env.POC_INTERVIEW_DATE || "").trim();
  const startTime = (process.env.POC_START_TIME || "").trim();
  const timezone = (process.env.POC_TIMEZONE || "").trim();

  const greeting = (process.env.POC_GREETING || "Hello").trim();
  const sleepMs = numFromEnv("POC_SLEEP_MS", 800);
  const evaluate = boolFromEnv("POC_EVALUATE", true);
  const fetchTranscript = boolFromEnv("POC_FETCH_TRANSCRIPT", true);
  const generateScript = boolFromEnv("POC_GENERATE_SCRIPT", true);

  const outputMeta = {
    poc: "AI_VIRTUAL_INTERVIEW",
    baseUrl,
    startedAt: new Date().toISOString(),
  };

  logSection("AI Virtual Interview POC (Dev / Local)");
  console.log("[POC] baseUrl:", baseUrl);

  if (!email || !password) {
    throw new Error("Missing POC_EMAIL or POC_PASSWORD.");
  }

  logSection("Step 1: Login");
  const loginRes = await requestJson(
    `${baseUrl}/api/auth/login`,
    {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email, password }),
    },
    30_000
  );

  if (!loginRes.ok) {
    console.log("[POC] Login failed:", loginRes.status, loginRes.body);
    throw new Error("Login failed. Check POC_EMAIL / POC_PASSWORD.");
  }

  const token = loginRes.body?.token;
  const user = loginRes.body?.user;
  if (!token) throw new Error("Login succeeded but no token returned.");
  console.log("[POC] Login OK. role:", user?.role, "| dbName:", loginRes.body?.dbName);

  const authHeaders = { Authorization: `Bearer ${token}` };
  const jsonHeaders = { ...authHeaders, "Content-Type": "application/json" };

  logSection("Step 2: Resolve Candidate / Job IDs");
  if ((!candidateId || !jobId) && candidateAtsId) {
    const atsRes = await requestJson(
      `${baseUrl}/api/candidateats/${candidateAtsId}`,
      { method: "GET", headers: authHeaders },
      30_000
    );
    if (atsRes.ok) {
      candidateId = candidateId || String(atsRes.body?.candidate || "");
      jobId = jobId || String(atsRes.body?.job || "");
      console.log("[POC] Resolved candidate/job from ATS:", { candidateId, jobId });
    } else {
      console.log("[POC] Candidate ATS lookup failed:", atsRes.status, atsRes.body);
    }
  }

  if (!candidateId || !jobId) {
    throw new Error("Missing candidateId or jobId. Set POC_CANDIDATE_ID and POC_JOB_ID.");
  }

  let schedule = null;
  let scheduleId = scheduleIdEnv || null;

  logSection("Step 3: Resolve Interview Schedule");
  if (createSchedule) {
    if (!candidateAtsId) {
      throw new Error("POC_CREATE_SCHEDULE=true but POC_CANDIDATE_ATS_ID is missing.");
    }

    const now = new Date();
    const interviewDate = startDate || formatDateLocal(now);
    const interviewStart = startTime || formatTimeLocal(now);

    const payload = {
      candidateATS: candidateAtsId,
      candidate: candidateId,
      job: jobId,
      interviewMode,
      interviewDate,
      startTime: interviewStart,
      durationMinutes,
      timezone: timezone || undefined,
      notes,
      interviewerType,
      interviewType,
      difficultyLevel,
      roundType,
    };

    console.log("[POC] Creating schedule:", payload);
    const createRes = await requestJson(
      `${baseUrl}/api/interviewschedules`,
      {
        method: "POST",
        headers: jsonHeaders,
        body: JSON.stringify(payload),
      },
      60_000
    );

    if (!createRes.ok) {
      console.log("[POC] Schedule create failed:", createRes.status, createRes.body);
      throw new Error(createRes.body?.error || "Failed to create schedule.");
    }

    schedule = createRes.body;
    scheduleId = schedule?._id ? String(schedule._id) : null;
    console.log("[POC] Schedule created:", scheduleId);
  }

  if (!scheduleId) {
    const listUrl = new URL(`${baseUrl}/api/interviewschedules`);
    listUrl.searchParams.set("candidateId", candidateId);
    listUrl.searchParams.set("jobId", jobId);

    const listRes = await requestJson(listUrl.toString(), { method: "GET", headers: authHeaders }, 30_000);
    if (listRes.ok) {
      const list = Array.isArray(listRes.body)
        ? listRes.body
        : Array.isArray(listRes.body?.items)
          ? listRes.body.items
          : [];
      schedule = pickLatestSchedule(list);
      scheduleId = schedule?._id ? String(schedule._id) : null;
      if (scheduleId) {
        console.log("[POC] Latest schedule resolved:", scheduleId);
      }
    } else {
      console.log("[POC] Schedule list failed:", listRes.status, listRes.body);
    }
  }

  if (scheduleId && !schedule) {
    const schedRes = await requestJson(
      `${baseUrl}/api/interviewschedules/${scheduleId}`,
      { method: "GET", headers: authHeaders },
      30_000
    );
    if (schedRes.ok) {
      schedule = schedRes.body;
    } else {
      console.log("[POC] Schedule fetch failed:", schedRes.status, schedRes.body);
    }
  }

  if (schedule) {
    console.log("[POC] Schedule context:", {
      scheduleId: schedule?._id,
      interviewMode: schedule?.interviewMode,
      interviewerType: schedule?.interviewerType,
      interviewType: schedule?.interviewType,
      roundType: schedule?.roundType,
    });

    if (requireAiSchedule) {
      if (schedule.interviewMode !== "Virtual" || schedule.interviewerType !== "AI") {
        throw new Error("Schedule is not Virtual + AI. Update schedule or set POC_REQUIRE_AI=false.");
      }
    }
  } else {
    console.log("[POC] No schedule found. Continuing without schedule context.");
  }

  logSection("Step 4: Load Candidate / Job Context");
  let candidate = null;
  let job = null;

  const candRes = await requestJson(
    `${baseUrl}/api/candidates/${candidateId}`,
    { method: "GET", headers: authHeaders },
    30_000
  );
  if (candRes.ok) candidate = candRes.body;

  const jobRes = await requestJson(
    `${baseUrl}/api/jobs/${jobId}`,
    { method: "GET", headers: authHeaders },
    30_000
  );
  if (jobRes.ok) job = jobRes.body;

  const candidateName = `${candidate?.firstName || ""} ${candidate?.lastName || ""}`.trim() || "Candidate";
  const jobTitle = job?.title || job?.internalTitle || "Job";

  console.log("[POC] candidateName:", candidateName);
  console.log("[POC] jobTitle:", jobTitle);

  logSection("Step 5: Resolve Technical Script");
  let technicalScript = typeof schedule?.technicalScript === "string" ? schedule.technicalScript : "";

  if (!technicalScript && generateScript && candidate && job) {
    const scriptPayload = {
      candidate,
      job,
      roundType: schedule?.roundType || roundType,
      interviewType: schedule?.interviewType || interviewType,
      difficultyLevel: schedule?.difficultyLevel || difficultyLevel,
      selectedBlueprint: schedule?.selectedBlueprint || [],
      durationMinutes: schedule?.durationMinutes || durationMinutes,
      scriptStyle: (process.env.POC_SCRIPT_STYLE || "Compact").trim(),
    };

    const scriptRes = await requestJson(
      `${baseUrl}/api/ai/generateTechnicalScript`,
      {
        method: "POST",
        headers: jsonHeaders,
        body: JSON.stringify(scriptPayload),
      },
      60_000
    );

    if (scriptRes.ok) {
      technicalScript = scriptRes.body?.script || "";
      console.log("[POC] Script generated (length):", technicalScript.length);
    } else {
      console.log("[POC] Script generation failed:", scriptRes.status, scriptRes.body);
    }
  } else if (!technicalScript && generateScript) {
    console.log("[POC] Skipping script generation (missing candidate/job context).");
  } else {
    console.log("[POC] Using schedule script (length):", technicalScript.length);
  }

  logSection("Step 6: AI Interview Q/A (Text)");
  const transcript = [];
  const envAnswers = parseAnswersFromEnv();
  const fallbackAnswers = [
    "I have experience building backend services and APIs, focusing on reliability and performance.",
    "In my last role, I led an API redesign that reduced latency and improved developer experience.",
    "I handle debugging by reproducing issues, analyzing logs, and validating fixes with metrics.",
    "I collaborate closely with product and design to align on requirements and measurable outcomes.",
  ];
  const answers = envAnswers.length ? envAnswers : fallbackAnswers;
  const maxTurns = numFromEnv("POC_TURNS", answers.length || 4);

  const respondMeta = {
    candidateId,
    jobId,
    ...(scheduleId ? { interviewScheduleId: scheduleId } : {}),
    jobTitle,
    candidateName,
    technicalScript: technicalScript || undefined,
    interviewType: schedule?.interviewType || interviewType,
    interviewerType: schedule?.interviewerType || interviewerType,
  };

  const callRespond = async (text) => {
    const res = await requestJson(
      `${baseUrl}/api/ai/respond`,
      {
        method: "POST",
        headers: jsonHeaders,
        body: JSON.stringify({ text, ...respondMeta }),
      },
      60_000
    );

    if (!res.ok) {
      throw new Error(res.body?.error || `AI respond failed: ${res.status}`);
    }

    return res.body?.response || "";
  };

  const firstAi = await callRespond(greeting);
  transcript.push({ role: "candidate", content: greeting });
  transcript.push({ role: "ai", content: firstAi });
  console.log("[POC] AI:", (firstAi || "").slice(0, 200));

  for (let i = 0; i < Math.min(maxTurns, answers.length); i++) {
    const answer = answers[i];
    if (!answer) continue;
    await sleep(sleepMs);
    const aiReply = await callRespond(answer);
    transcript.push({ role: "candidate", content: answer });
    transcript.push({ role: "ai", content: aiReply });
    console.log(`[POC] Turn ${i + 1} AI:`, (aiReply || "").slice(0, 200));
  }

  logSection("Step 7: End Interview");
  const endPayload = { candidateId, jobId, ...(scheduleId ? { interviewScheduleId: scheduleId } : {}) };
  const endRes = await requestJson(
    `${baseUrl}/api/ai/endInterview`,
    { method: "POST", headers: jsonHeaders, body: JSON.stringify(endPayload) },
    30_000
  );

  if (endRes.ok) {
    console.log("[POC] End interview OK.");
  } else {
    console.log("[POC] End interview failed:", endRes.status, endRes.body);
  }

  logSection("Step 8: Evaluate (Optional)");
  let evalRes = null;
  if (evaluate) {
    evalRes = await requestJson(
      `${baseUrl}/api/ai/evaluateInterview`,
      { method: "POST", headers: jsonHeaders, body: JSON.stringify(endPayload) },
      120_000
    );

    if (evalRes.ok) {
      console.log("[POC] Evaluation OK. score:", evalRes.body?.score ?? evalRes.body?.totalScore);
    } else {
      console.log("[POC] Evaluation failed:", evalRes.status, evalRes.body);
    }
  } else {
    console.log("[POC] POC_EVALUATE=false, skipping evaluation.");
  }

  logSection("Step 9: Transcript (Optional)");
  let transcriptRes = null;
  if (fetchTranscript && scheduleId) {
    transcriptRes = await requestJson(
      `${baseUrl}/api/interviewschedules/${scheduleId}/transcript`,
      { method: "GET", headers: authHeaders },
      30_000
    );
    if (transcriptRes.ok) {
      console.log("[POC] Transcript fetched.");
    } else {
      console.log("[POC] Transcript fetch failed:", transcriptRes.status, transcriptRes.body);
    }
  } else if (!scheduleId) {
    console.log("[POC] No scheduleId; transcript fetch skipped.");
  } else {
    console.log("[POC] POC_FETCH_TRANSCRIPT=false, skipping transcript.");
  }

  const okFile = writeArtifact(`ai-virtual-interview.ok.${Date.now()}.json`, {
    meta: {
      ...outputMeta,
      candidateId,
      jobId,
      scheduleId,
      finishedAt: new Date().toISOString(),
    },
    schedule: schedule || null,
    candidate: candidate || null,
    job: job || null,
    technicalScriptLength: technicalScript.length,
    transcript,
    endInterview: endRes?.body || null,
    evaluation: evalRes?.body || null,
    transcriptFetch: transcriptRes?.body || null,
  });

  logSection("Done");
  console.log("[POC] AI Virtual Interview POC completed.");
  console.log("[POC] Output saved:", okFile);
}

main().catch((err) => {
  console.error("\n[POC] Failed:", err?.message || err);
  const failFile = writeArtifact(`ai-virtual-interview.fail.${Date.now()}.json`, {
    error: err?.message || String(err),
    stack: err?.stack || null,
    when: new Date().toISOString(),
  });
  console.error("[POC] Failure output saved:", failFile);
  process.exit(1);
});
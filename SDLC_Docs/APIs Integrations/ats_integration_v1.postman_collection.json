				{
					"name": "Generate Job Description (AI)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"let result = {};",
									"try { result = pm.response.json() || {}; } catch (e) {}",
									"let jobDescObj = result.jobDescription || (result.details && result.details.jobDescription) || null;",
									"let finalText = '';",
									"if (typeof jobDescObj === 'string') {",
									"    finalText = jobDescObj;",
									"} else if (jobDescObj && typeof jobDescObj === 'object') {",
									"    const overview = jobDescObj.overview || '';",
									"    const responsibilities = Array.isArray(jobDescObj.responsibilities) ? jobDescObj.responsibilities : [];",
									"    const requirements = Array.isArray(jobDescObj.requirements) ? jobDescObj.requirements : [];",
									"    const benefits = Array.isArray(jobDescObj.benefits) ? jobDescObj.benefits : [];",
									"    const full = [",
									"        overview,",
									"        responsibilities.length ? 'Responsibilities:\\n' + responsibilities.join('\\n') : '',",
									"        requirements.length ? 'Requirements:\\n' + requirements.join('\\n') : '',",
									"        benefits.length ? 'Benefits:\\n' + benefits.join('\\n') : ''",
									"    ].filter(Boolean).join('\\n\\n');",
									"    finalText = full && full.trim() ? full : '';",
									"}",
									"if (!finalText) {",
									"    finalText = 'a dummy description';",
									"}",
									"pm.collectionVariables.set('jobDescription', finalText);",
									"pm.globals.set('jobDescription', finalText);",
									"pm.test('JD generated', function () {",
									"    pm.expect(finalText).to.be.ok;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [

			"name": "Scripts",
			"item": [
				{
					"name": "Generate Script via AI",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var payload = {};\r",
									"try { payload = pm.response.json(); } catch (e) {}\r",
									"var scriptCntRes = payload;\r",
									"if (scriptCntRes && scriptCntRes?.content) {\r",
									"    pm.collectionVariables.set('scriptContent', `${scriptCntRes?.content}`);\r",
									"    pm.globals.set('scriptContent', `${scriptCntRes?.content}`);\r",
									"}\r",
									"pm.test('Script content generated', function () {\r",
									"    pm.expect(scriptCntRes && scriptCntRes?.content).to.be.ok;\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",

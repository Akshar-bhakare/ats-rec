					"name": "Login (Client Admin / Recruiter)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var data = {};",
									"try { data = pm.response.json(); } catch (e) {}",
									"if (data && data.token) {",
									"    pm.collectionVariables.set('authToken', data.token);",
									"}",
									"pm.test('Login succeeded', function () {",
									"    pm.response.to.have.status(200);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"demo.partner@hirexit.com\",\n  \"password\": \"Passw0rd!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],

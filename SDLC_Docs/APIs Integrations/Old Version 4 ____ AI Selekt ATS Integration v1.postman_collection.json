      "description": "Bootstrap session + capture JWT for subsequent requests.",
      "item": [
        {
          "name": "Login (Client Admin / Recruiter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Authenticate with tenant credentials to seed the bearer token variable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.partner@hirexit.com\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "if (data && data.token) {",
                  "    pm.globals.set('authToken', data.token);",
                  "}",
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

    {
      "name": "ATS Snapshot & Conversations",
      "description": "Helper endpoints to inspect CandidateATS stage data and transcripts.",
      "item": [
        {
          "name": "List Candidate ATS View",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/candidates/ats",
            "description": "Returns candidates + applications (CandidateATS records) like the recruiter UI grid."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var candidateId = pm.globals.get('candidateId');",
                  "var data = [];",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "var match;",
                  "if (Array.isArray(data)) {",
                  "    data.forEach(function (cand) {",
                  "        if (match) { return; }",
                  "        var cid = cand && (cand._id || cand.id);",
                  "        if (cid && candidateId && cid === candidateId) {",
                  "            match = cand;",
                  "        }",
                  "    });",
                  "}",
                  "if (match && Array.isArray(match.applications) && match.applications.length) {",
                  "    var atsId = match.applications[0] && (match.applications[0]._id || match.applications[0].id);",
                  "    if (atsId) {",
                  "        pm.globals.set('atsId', atsId);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Candidate ATS Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/candidates/ats/{{atsId}}?fields=stageResults",
            "description": "Loads a single CandidateATS record with ordered stage results."
          },
          "response": []
        },
        {
          "name": "Fetch AI Conversation Transcript",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text"
